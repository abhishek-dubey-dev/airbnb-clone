<nav class="site-navbar sticky-top" aria-label="Primary navigation">
  <div class="site-navbar-inner">
    <a class="brand-mark" href="/listings" aria-label="WanderLust home">
      <i class="fa-brands fa-airbnb" aria-hidden="true"></i>
      <span>airbnb</span>
    </a>

    <form class="navbar-search" action="/listings" method="GET" role="search">
      <label class="search-field">
        <span>Where</span>
        <input type="search" name="location" placeholder="Search destinations" />
      </label>
      <label class="search-field search-field-date">
        <span>When</span>
        <input type="text" placeholder="Add dates" aria-label="Add dates" />
      </label>
      <label class="search-field search-field-guests">
        <span>Who</span>
        <input type="text" placeholder="Add guests" aria-label="Add guests" />
      </label>
      <button class="search-button" type="submit" aria-label="Search listings" title="Search listings">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> 
      </button>
    </form>

    <div class="navbar-actions">
      <a class="host-link" href="/listings/new">airbnb your home</a>
      <button class="globe-button" type="button" aria-label="Choose language" title="Choose language">
        <i class="fa-solid fa-globe" aria-hidden="true"></i>
      </button>
      <div class="profile-menu">
        <button class="profile-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Open account menu" title="Account menu">
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
          <i class="fa-solid fa-circle-user" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">
          <% if(!currUser) { %>
            <li><a class="dropdown-item" href="/signup">Sign up</a></li>
            <li><a class="dropdown-item" href="/login">Log in</a></li>
          <% } else { %>
            <li><span class="dropdown-item-text">Welcome back</span></li>
            <li><a class="dropdown-item" href="/logout">Log out</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </div>
